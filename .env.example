# Copia este archivo a .env (o exporta las variables). Todas son opcionales: el sistema funciona sin ellas.
PORT=3000
# URL pública base: se usa en los códigos QR y en los correos. Si el celular escanea el QR en tu red local,
# pon aquí la IP de tu PC, p. ej. http://192.168.1.50:3000  (o la URL https de un túnel).
BASE_URL=
# Carpeta de datos (base SQLite y clave JWT) y archivo de BD
DATA_DIR=
DB_FILE=
# Carpeta de archivos subidos (comprobantes privados y logos/fotos públicas). Por defecto ./uploads
UPLOADS_DIR=
# Secreto JWT/HMAC. Si se omite se genera uno en data/.secret la primera vez. EN PRODUCCIÓN DEFÍNELO.
JWT_SECRET=
# Zona horaria de negocio
TZ_APP=America/Guayaquil
# Límite de peticiones por minuto y por IP para /api
RATE_LIMIT=600
# Muestra las cuentas de demostración en la pantalla de ingreso (pon false en producción)
DEMO_MODE=true
# Correo saliente (opcional). Sin SMTP, los correos solo se guardan en la bandeja interna (Superadmin > Auditoría > Correos)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RutaEC <no-reply@rutaec.example>"
